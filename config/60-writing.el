(defun org-export-replace-scene-breaks (text backend _info)
  "Replace SCENE-BREAK markers with backend-appropriate scene separators."
  (let ((replacement
         (pcase backend
           ;; Markdown, ASCII, man: visible marker for reliability
           ((or 'ascii 'md 'man)
            "\n***\n\n")
           ;; HTML: visual spacing
           ('html "<br><br><br>\n")
           ;; LaTeX/PDF: vertical space
           ('latex "\\vspace{\\baselineskip}\\vspace{\\baselineskip}\\vspace{\\baselineskip}\n")
           ;; Everything else: 3 blank lines
           (_ "\n\n\n"))))
    (replace-regexp-in-string "SCENE-BREAK" replacement text t t)))

;; `org-export-filter-final-output-functions' is defined in ox, so touching
;; it at startup would force the exporter to load.  Register on ox instead.
(with-eval-after-load 'ox
  (add-to-list 'org-export-filter-final-output-functions
               #'org-export-replace-scene-breaks))

(defvar my-writing-stories-directory "~/Nextcloud/escritura/historias/ejercicios"
  "Directory where org files created by `my-writing--new-file' will be stored.")

(defun my-writing--new-file (title &optional with-prompt)
  "Create and open a new writing file named after TITLE.
The file is stored in `my-writing-stories-directory' with the name format
`%Y%m%d-<title>.org' (spaces in TITLE replaced by underscores) and a standard
org front matter.  When WITH-PROMPT is non-nil, append a writing prompt
generated by the writing_companion script."
  (let* ((date (format-time-string "%Y%m%d"))
         (file-name (concat date "-" (replace-regexp-in-string " " "_" title) ".org"))
         (file-path (expand-file-name file-name my-writing-stories-directory))
         (front-matter (format "#+TITLE: %s\n#+AUTHOR: %s\n#+EMAIL: %s\n#+MACRO: scene-break SCENE-BREAK\n"
                               title user-full-name user-mail-address))
         (prompt (when with-prompt
                   (shell-command-to-string
                    "python  ~/Nextcloud/escritura/software/writing_companion/writing_companion.py -s all prompt"))))
    (with-temp-file file-path
      (insert front-matter)
      (when prompt (insert "\n\n" prompt)))
    (find-file file-path)))

(defun my-writing/create-empty-writing-file (title)
  "Create and open a new empty writing file named after TITLE."
  (interactive "sEnter file name: ")
  (my-writing--new-file title))

(defun my-writing/create-writing-exercise (title)
  "Create and open a new writing file named after TITLE, seeded with a generated prompt."
  (interactive "sEnter file name: ")
  (my-writing--new-file title t))

(defvar my-writing-root
  (expand-file-name "~/Nextcloud/escritura/historias/novela")
  "Root directory holding my writing projects, one subdirectory per project.")

(defvar my/last-writing-project nil
  "Last writing project chosen via `my/start-writing-session'.
Persisted across sessions via `savehist-additional-variables'.")

(defun my-writing--projects ()
  "Return the subdirectories of `my-writing-root' as a list of names."
  (when (file-directory-p my-writing-root)
    (seq-filter
     (lambda (name)
       (and (not (string-prefix-p "." name))
            (file-directory-p (expand-file-name name my-writing-root))))
     (directory-files my-writing-root))))

(defun my/start-writing-session (project)
  "Open a writing PROJECT and enter the writing environment.
Interactively, prompt to pick among the subdirectories of `my-writing-root',
defaulting to the last project used (remembered across sessions).  Press RET on
the empty prompt to reopen that last project."
  (interactive
   (let* ((projects (my-writing--projects))
          ;; surface the last-used project first so it is the primary choice
          (ordered (if (and my/last-writing-project
                            (member my/last-writing-project projects))
                       (cons my/last-writing-project
                             (remove my/last-writing-project projects))
                     projects)))
     (list (completing-read
            (format-prompt "Writing project" my/last-writing-project)
            ordered nil t nil nil my/last-writing-project))))
  (setq my/last-writing-project project)
  (let ((default-directory (file-name-as-directory
                            (expand-file-name project my-writing-root))))
    (call-interactively #'project-find-file))
  (when (fboundp 'org-scribe/writing-env-mode)
    (org-scribe/writing-env-mode 1)))

(defvar-keymap my/key-prefix-writing-map
  :doc "Functions related to writing"
  ;; open a writing session
  "o" #'my/start-writing-session
  ;; writing mode
  "a" #'org-scribe/writing-env-mode
  "f" #'org-scribe/writing-env-mode-focus
  "e" #'org-scribe/editing-mode
  "w" #'org-scribe/ews-org-count-words
  "c" #'org-context-count-words
  ;; writing exercises
  "r" #'my-writing/create-writing-exercise
  "q" #'my-writing/create-empty-writing-file
  "s" #'org-scribe/sinonimo
  ;; hydra keybinding
  "k" #'hydra-org-scribe/body)

(keymap-global-set "<f8> <f8>" #'hydra-org-scribe/body)
;; true one-key entry point for a writing session
(keymap-global-set "<f7>" #'my/start-writing-session)

