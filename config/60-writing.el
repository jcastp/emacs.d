(defun my/writing-focus-mode ()
  "Toggle a distraction-free writing environment.
Uses my/centered-mode for margins, extra line spacing, and hides line numbers."
  (interactive)
  (if (bound-and-true-p my/centered-mode)
      (progn
        (my/centered-mode -1)
        (setq-local line-spacing 0)
        (display-line-numbers-mode 1))
    (progn
      (my/centered-mode 1)
      (setq-local line-spacing 4)
      (display-line-numbers-mode -1))))

(global-set-key (kbd "C-c 5") #'my/writing-focus-mode)

